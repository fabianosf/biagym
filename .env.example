# BiAGym – variáveis de ambiente
# Copie para .env e preencha com os valores do projeto Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Apenas para scripts de seed (não usar no app)
# SUPABASE_SERVICE_ROLE_KEY=

# Observabilidade (Sentry) – produção
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_ENABLED_IN_DEV=false

# Opcional: preenchido após `eas init` / `eas project:info`
EXPO_PUBLIC_EAS_PROJECT_ID=
